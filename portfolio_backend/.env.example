# Server configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# MongoDB connection
# Preferred: full connection URI
# Note: the code reads MONGODB_URL primarily; MONGODB_URI is provided here for clarity and can be copied to MONGODB_URL.
MONGODB_URL=mongodb://localhost:27017/portfolio
# Alternative parts-based config (used if MONGODB_URL is not set)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=portfolio
# Optional auth
# MONGODB_USER=
# MONGODB_PASSWORD=
