# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS (comma-separated origins or * for any)
CORS_ORIGIN=http://localhost:3000

# MongoDB connection - prefer MONGODB_URL. If not set, fallback to parts are used.
# Example full connection string:
# MONGODB_URL=mongodb://username:password@localhost:27017/portfolio?authSource=admin
MONGODB_URL=
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=portfolio
# Optional auth when not using MONGODB_URL
MONGODB_USER=
MONGODB_PASSWORD=
