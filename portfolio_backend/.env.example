# Backend environment example

# Preferred full Mongo connection string (copy from portfolio_database/db_connection.txt)
MONGODB_URI=mongodb://appuser:dbuser123@localhost:5000/myapp?authSource=admin

# Legacy alias still supported (optional)
# MONGODB_URL=

# Optional granular settings if not using full URI
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_DB=portfolio
# MONGODB_USER=
# MONGODB_PASSWORD=

# Web server
PORT=3001
HOST=0.0.0.0

# CORS: set to your frontend URL; multiple origins can be comma separated
CORS_ORIGIN=http://localhost:3000

# Node environment
NODE_ENV=development
